# Server-only secrets. Never expose through NEXT_PUBLIC_*.
OPENAI_API_KEY=
SARVAM_API_KEY=
GEMINI_API_KEY=

# Sarvam is the primary India-first voice chain. OpenAI Realtime remains available
# at /debug/openai for comparison. GEMINI_API_KEY is reserved for the upcoming
# Gemini Live test adapter and is not used by the primary route yet.
VOICE_ENGINE=sarvam_chain
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_DEV_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_REASONING_EFFORT=low
OPENAI_TURN_DETECTION=semantic_vad

# India-first voice chain: Saaras STT -> Sarvam Conversations -> Bulbul TTS.
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_LANGUAGE=unknown
SARVAM_CHAT_MODEL=sarvam-105b-conversations
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_LANGUAGE=hi-IN
SARVAM_TTS_SPEAKER=ritu
SARVAM_TTS_PACE=0.85
SARVAM_REQUEST_TIMEOUT_MS=45000
SARVAM_MAX_AUDIO_BYTES=8000000
SARVAM_HISTORY_MESSAGES=16

# Local application configuration.
# Optional independent key for encrypting browser-held conversation context.
# If blank, a domain-separated key is derived from SARVAM_API_KEY.
CONVERSATION_STATE_SECRET=
DATABASE_URL=file:./dev.db
APP_ORIGIN=http://localhost:3000
STORE_RAW_TRANSCRIPTS=false
ENABLE_MEMORY=false
ENABLE_SAFETY_MONITOR=false
ENABLE_REMINDERS=false
ENABLE_SARVAM_FALLBACK=false
ENABLE_VOICE_CLONE=false
LOG_LEVEL=info
